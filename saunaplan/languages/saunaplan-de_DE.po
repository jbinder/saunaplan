msgid "Confirm email address"
msgstr "E-Mail-Adresse bestätigen"

msgid "To the booking page"
msgstr "Zur Buchungsseite"

msgid "This link is no longer valid. Maybe the address was already confirmed or changed."
msgstr "Dieser Link ist nicht mehr gültig. Vielleicht wurde die Adresse schon bestätigt oder geändert."

msgid "Email address confirmed"
msgstr "E-Mail-Adresse bestätigt"

msgid "Thank you! From now on, booking mails go to %s."
msgstr "Danke! Buchungsmails gehen ab jetzt an %s."

msgid "Yes, confirm this address"
msgstr "Ja, diese Adresse bestätigen"

msgid "Send booking confirmations and reminders to %s?"
msgstr "Buchungsbestätigungen und Erinnerungen an %s schicken?"

msgid "{room}: booked for {date}, {time}"
msgstr "{room}: gebucht für {date}, {time}"

msgid "Hello,\n\nyou are booked:\n\n{date}\n{time}\n{details}\n\nCan't make it? Please cancel on the booking page so others can use the slot:\n{page_url}"
msgstr "Hallo,\n\ndu hast gebucht:\n\n{date}\n{time}\n{details}\n\nDu kannst doch nicht? Bitte storniere auf der Buchungsseite, damit andere die Zeit nutzen können:\n{page_url}"

msgid "Reminder – {room} on {date}, {time}"
msgstr "Erinnerung – {room} am {date}, {time}"

msgid "Hello,\n\na friendly reminder of your booking:\n\n{date}\n{time}\n{details}\n\n{instructions}\n\nBooking page: {page_url}"
msgstr "Hallo,\n\neine kurze Erinnerung an deine Buchung:\n\n{date}\n{time}\n{details}\n\n{instructions}\n\nBuchungsseite: {page_url}"

msgid "Cancelled – {room} on {date}, {time}"
msgstr "Abgesagt – {room} am {date}, {time}"

msgid "Hello,\n\nthe session on {date}, {time} has been cancelled. Your place in it has been removed – there is nothing you need to do.\n\nBooking page: {page_url}"
msgstr "Hallo,\n\nder Termin am {date}, {time} wurde abgesagt. Dein Platz wurde entfernt – du musst nichts weiter tun.\n\nBuchungsseite: {page_url}"

msgid "A place is free – {room} on {date}, {time}"
msgstr "Ein Platz ist frei – {room} am {date}, {time}"

msgid "Hello,\n\ngood news: the slot you were waiting for ({date}, {time}) has become available.\nEveryone on the waiting list gets this message – whoever books first gets it.\n\nBook now: {page_url}"
msgstr "Hallo,\n\ngute Nachricht: Die Zeit, auf die du gewartet hast ({date}, {time}), ist frei geworden.\nAlle auf der Warteliste bekommen diese Nachricht – wer zuerst bucht, bekommt sie.\n\nJetzt buchen: {page_url}"

msgid "How was it? – {room} on {date}"
msgstr "Wie war's? – {room} am {date}"

msgid "Hello,\n\nhow was your session on {date}, {time}? Rating takes about ten seconds and helps everyone:\n{rate_url}"
msgstr "Hallo,\n\nwie war dein Termin am {date}, {time}? Die Bewertung dauert etwa zehn Sekunden und hilft allen:\n{rate_url}"

msgid "Please confirm your email address"
msgstr "Bitte bestätige deine E-Mail-Adresse"

msgid "Hello,\n\nplease confirm that you want booking confirmations and reminders for the {room} at this address:\n{confirm_url}\n\nIf you did not ask for this, just ignore this message."
msgstr "Hallo,\n\nbitte bestätige, dass du Buchungsbestätigungen und Erinnerungen für die {room} an diese Adresse bekommen möchtest:\n{confirm_url}\n\nWenn du das nicht angefordert hast, ignoriere diese Nachricht einfach."

msgid "{room}: feedback for {date}, {time}"
